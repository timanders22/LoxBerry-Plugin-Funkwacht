#!/bin/bash
# Funkwacht - Deinstallation
#
# Die Deinstallation von LoxBerry entfernt nur die Ordner des Plugins selbst.
# Eine Sicherungsdatei DANEBEN bliebe liegen.
#
# Die Rechtedatei raeumt der Installer selbst ab: sie kommt seit 1.0.3 als
# sudoers/sudoers ins Archiv, und plugininstall.pl loescht
# system/sudoers/<NAME> beim Deinstallieren (purge_installation, Schritt 6).
# Der fruehere Block "sudo -n rm -f /etc/sudoers.d/funkwacht" ist entfallen.
#
# Aufruf durch den Installer: data/system/uninstall/<name>
#   <TEMPFILE> <NAME> <FOLDER> <VERSION> <BASEFOLDER> <TEMPFOLDER>
# Ordner und Wurzel kommen deshalb aus $3 und $5. Bis hierher wurde der Ordner
# aus dem eigenen Ablageort abgeleitet - installiert ist das data/system, der
# Ordnername wurde "system" (am Geraet so errechnet, 17.09.2026; Regeln/06).
SELF=$(cd "$(dirname "$0")" && pwd)
ARGV3=$3
ARGV5=$5
PFOLDER="${ARGV3:-funkwacht}"
BASE="${ARGV5:-$LBHOMEDIR}"
if [ -z "$BASE" ] || [ ! -d "$BASE" ]; then
    BASE=$(cd "$SELF/../../.." 2>/dev/null && pwd)
fi

PBIN="$BASE/bin/plugins/$PFOLDER"
DIENST="$PBIN/dienst.sh"
[ -x "$DIENST" ] && "$DIENST" stop >/dev/null 2>&1

# Zwei Prozesse seit 1.0.0: der Waechter und der MQTT-Mithoerer.
#
# Solange dienst.sh da ist, hat die Zeile darueber beide schon abgeraeumt -
# am 18.09.2026 in WSL gemessen (Bestand-2026-09-18/klasse-F-nachmessung,
# Zeile 4): eine voellig fremde Nummer in dienst.pid ueberlebte die
# Deinstallation, weil "dienst.sh stop" die Datei entfernt, ohne zu
# signalisieren. FEHLT dienst.sh aber - beschaedigte Installation, Ordner
# schon halb abgeraeumt -, traegt sie nicht mehr. Bis 1.0.5 stand hier dann
# ein unbedingtes "kill -9" auf die blanke Nummer aus der PID-Datei; gemessen
# ebenda, Abschnitt 2: mit "chmod -x dienst.sh" war der fremde Prozess tot.
#
# Deshalb dieselbe argumentweise Probe wie in bin/dienst.sh, und zusaetzlich
# eine Suche ueber /proc: purge_installation loescht data/plugins/<ordner>/,
# ein Dienst ohne PID-Datei bliebe sonst nach dem Deinstallieren stehen.
DIENST_UID=$(id -u loxberry 2>/dev/null || id -u)

# $1 = Prozessnummer, $2 = Skriptpfad, $3 = derselbe Pfad ueber readlink -f
fw_ist_dienst() {
    [ -r "/proc/$1/cmdline" ] || return 1
    {
        IFS= read -r -d '' fw_a0 || return 1
        IFS= read -r -d '' fw_a1 || return 1
        case "${fw_a0##*/}" in python|python3|python3.*) ;; *) return 1 ;; esac
        if [ "$fw_a1" != "$2" ]; then
            case "$fw_a1" in
                /*) fw_r=$(readlink -f "$fw_a1" 2>/dev/null) ;;
                *)  fw_w=$(readlink -f "/proc/$1/cwd" 2>/dev/null)
                    [ -n "$fw_w" ] || return 1
                    fw_r=$(readlink -f "$fw_w/$fw_a1" 2>/dev/null) ;;
            esac
            [ -n "$fw_r" ] && [ "$fw_r" = "$3" ] || return 1
        fi
        IFS= read -r -d '' fw_a2 && return 1
        return 0
    } < "/proc/$1/cmdline"
}

# $1 = PID-Datei, $2 = Skriptpfad
fw_dienste() {
    fw_sr=$(readlink -f "$2" 2>/dev/null)
    [ -n "$fw_sr" ] || fw_sr="$2"
    {
        for fw_d in /proc/[0-9]*; do
            fw_n="${fw_d#/proc/}"
            fw_ist_dienst "$fw_n" "$2" "$fw_sr" || continue
            [ "$(stat -c %u "$fw_d" 2>/dev/null)" = "$DIENST_UID" ] || continue
            echo "$fw_n"
        done
        fw_p=""
        [ -f "$1" ] && IFS= read -r fw_p < "$1" 2>/dev/null
        case "$fw_p" in
            ''|*[!0-9]*) ;;
            *) fw_ist_dienst "$fw_p" "$2" "$fw_sr" && echo "$fw_p" ;;
        esac
    } | sort -un
}

for N in dienst:funkwacht_dienst.py mithoerer:fw_mqtt.py; do
    PID="$BASE/data/plugins/$PFOLDER/${N%%:*}.pid"
    SKRIPT="$PBIN/${N##*:}"
    ZIEL=$(fw_dienste "$PID" "$SKRIPT")
    if [ -n "$ZIEL" ]; then
        kill $ZIEL 2>/dev/null || true
        for i in 1 2 3 4 5; do
            [ -n "$(fw_dienste "$PID" "$SKRIPT")" ] || break
            sleep 1
        done
        # Vor dem harten Signal NEU suchen: zwischen den beiden Signalen kann
        # ein Prozess enden und seine Nummer neu vergeben werden.
        REST=$(fw_dienste "$PID" "$SKRIPT")
        [ -n "$REST" ] && kill -9 $REST 2>/dev/null || true
    fi
    rm -f "$PID"
done

# Beides liegt NEBEN dem jeweiligen Ordner und ueberlebt deshalb jedes
# Update - also auch das Deinstallieren, wenn es hier nicht steht.
rm -f "$BASE/config/plugins/$PFOLDER.backup.json"
rm -rf "$BASE/data/plugins/$PFOLDER.bestand"
# Die Upgrade-Marke liegt ebenfalls NEBEN dem Ordner. Bliebe sie liegen,
# haette eine spaetere Neuinstallation eine fremde Marke vor sich - sie gilt
# zwar nach 3600 s nicht mehr, aber liegenlassen ist kein Aufraeumen.
rm -f "$BASE/data/plugins/$PFOLDER.upgrade_laeuft"
rm -rf "$BASE/data/plugins/$PFOLDER"

echo "<OK> Funkwacht entfernt, Sicherungsdatei geloescht."
exit 0
