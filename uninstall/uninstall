#!/bin/bash
# Funkwacht - Deinstallation
#
# Die Deinstallation von LoxBerry entfernt nur die Ordner des Plugins selbst.
# Eine Sicherungsdatei DANEBEN bliebe liegen.
#
# Die Rechtedatei raeumt der Installer selbst ab: sie kommt seit 1.0.3 als
# sudoers/sudoers ins Archiv, und plugininstall.pl loescht
# system/sudoers/<NAME> beim Deinstallieren (purge_installation, Schritt 6).
# Der fruehere Block "sudo -n rm -f /etc/sudoers.d/funkwacht" ist entfallen.
#
# Aufruf durch den Installer: data/system/uninstall/<name>
#   <TEMPFILE> <NAME> <FOLDER> <VERSION> <BASEFOLDER> <TEMPFOLDER>
# Ordner und Wurzel kommen deshalb aus $3 und $5. Bis hierher wurde der Ordner
# aus dem eigenen Ablageort abgeleitet - installiert ist das data/system, der
# Ordnername wurde "system" (am Geraet so errechnet, 17.09.2026; Regeln/06).
SELF=$(cd "$(dirname "$0")" && pwd)
ARGV3=$3
ARGV5=$5
PFOLDER="${ARGV3:-${LBPPLUGINDIR:-funkwacht}}"
BASE="${ARGV5:-${LBHOMEDIR:-}}"
# Die Wurzel wird GELESEN: $5 vom Installer, sonst $LBHOMEDIR - und dann
# nur diese; traegt sie kein config/plugins und data/plugins, geschieht
# nichts. Sind beide leer, wird vom eigenen Ablageort aufwaerts gesucht, bis
# ein Verzeichnis config/plugins, data/plugins UND config/system/general.json
# traegt (Regeln/06, Raumklima-Vorfall). Danach KEIN Rueckfall auf feste
# Ebenen. Bis 1.0.6 stand hier ein Rueckfall ueber dem eigenen Ablageort,
# ohne general.json und ohne Abbruch; in einem fremden Baum wurde dort
# angelegt bzw. geloescht (Pruefung-Funkwacht-1.0.6/messe_haken.sh, Faelle
# K1, K4, K6, K8).
fw_wurzel_suchen() {
    fw_v=$(cd "$1" 2>/dev/null && pwd -P) || return 1
    fw_i=0
    while [ -n "$fw_v" ] && [ "$fw_v" != "/" ] && [ "$fw_i" -lt 8 ]; do
        if [ -d "$fw_v/config/plugins" ] && [ -d "$fw_v/data/plugins" ] \
           && [ -f "$fw_v/config/system/general.json" ]; then
            echo "$fw_v"
            return 0
        fi
        fw_v=$(dirname "$fw_v")
        fw_i=$((fw_i + 1))
    done
    return 1
}
if [ -z "$BASE" ]; then
    BASE=$(fw_wurzel_suchen "$(dirname "$(readlink -f "$0")")") || BASE=""
elif [ ! -d "$BASE/config/plugins" ] || [ ! -d "$BASE/data/plugins" ]; then
    echo "<FAIL> $BASE (fuenftes Argument bzw. \$LBHOMEDIR) traegt kein config/plugins und data/plugins."
    BASE=""
fi
if [ -z "$BASE" ]; then
    echo "<FAIL> Es wurde keine LoxBerry-Wurzel gelesen oder gefunden: weder als fuenftes"
    echo "<FAIL> Argument noch in \$LBHOMEDIR, und oberhalb von $(dirname "$0") traegt kein"
    echo "<FAIL> Verzeichnis config/plugins, data/plugins und config/system/general.json."
    echo "<FAIL> Es wurde nichts angelegt, nichts geloescht und kein Dienst angefasst."
    exit 1
fi
case "$PFOLDER" in
    ''|.|..|*/*)
        echo "<FAIL> Ungueltiger Ordnername '$PFOLDER' - es wurde nichts angefasst."
        exit 1 ;;
esac

PBIN="$BASE/bin/plugins/$PFOLDER"
DIENST="$PBIN/dienst.sh"
[ -x "$DIENST" ] && "$DIENST" stop >/dev/null 2>&1

# Zwei Prozesse seit 1.0.0: der Waechter und der MQTT-Mithoerer.
#
# Solange dienst.sh da ist, hat die Zeile darueber beide schon abgeraeumt -
# am 18.09.2026 in WSL gemessen (Bestand-2026-09-18/klasse-F-nachmessung,
# Zeile 4): eine voellig fremde Nummer in dienst.pid ueberlebte die
# Deinstallation, weil "dienst.sh stop" die Datei entfernt, ohne zu
# signalisieren. FEHLT dienst.sh aber - beschaedigte Installation, Ordner
# schon halb abgeraeumt -, traegt sie nicht mehr. Bis 1.0.5 stand hier dann
# ein unbedingtes "kill -9" auf die blanke Nummer aus der PID-Datei; gemessen
# ebenda, Abschnitt 2: mit "chmod -x dienst.sh" war der fremde Prozess tot.
#
# Deshalb dieselbe argumentweise Probe wie in bin/dienst.sh, und zusaetzlich
# eine Suche ueber /proc: purge_installation loescht data/plugins/<ordner>/,
# ein Dienst ohne PID-Datei bliebe sonst nach dem Deinstallieren stehen.
DIENST_UID=$(id -u loxberry 2>/dev/null || id -u)

# $1 = Prozessnummer, $2 = Skriptpfad, $3 = derselbe Pfad ueber readlink -f
fw_ist_dienst() {
    [ -r "/proc/$1/cmdline" ] || return 1
    {
        IFS= read -r -d '' fw_a0 || return 1
        IFS= read -r -d '' fw_a1 || return 1
        case "${fw_a0##*/}" in python|python3|python3.*) ;; *) return 1 ;; esac
        if [ "$fw_a1" != "$2" ]; then
            case "$fw_a1" in
                /*) fw_r=$(readlink -f "$fw_a1" 2>/dev/null) ;;
                *)  fw_w=$(readlink -f "/proc/$1/cwd" 2>/dev/null)
                    [ -n "$fw_w" ] || return 1
                    fw_r=$(readlink -f "$fw_w/$fw_a1" 2>/dev/null) ;;
            esac
            [ -n "$fw_r" ] && [ "$fw_r" = "$3" ] || return 1
        fi
        IFS= read -r -d '' fw_a2 && return 1
        return 0
    } < "/proc/$1/cmdline"
}

# $1 = PID-Datei, $2 = Skriptpfad
fw_dienste() {
    fw_sr=$(readlink -f "$2" 2>/dev/null)
    [ -n "$fw_sr" ] || fw_sr="$2"
    {
        for fw_d in /proc/[0-9]*; do
            fw_n="${fw_d#/proc/}"
            fw_ist_dienst "$fw_n" "$2" "$fw_sr" || continue
            [ "$(stat -c %u "$fw_d" 2>/dev/null)" = "$DIENST_UID" ] || continue
            echo "$fw_n"
        done
        fw_p=""
        [ -f "$1" ] && IFS= read -r fw_p < "$1" 2>/dev/null
        case "$fw_p" in
            ''|*[!0-9]*) ;;
            *) fw_ist_dienst "$fw_p" "$2" "$fw_sr" && echo "$fw_p" ;;
        esac
    } | sort -un
}

for N in dienst:funkwacht_dienst.py mithoerer:fw_mqtt.py; do
    PID="$BASE/data/plugins/$PFOLDER/${N%%:*}.pid"
    SKRIPT="$PBIN/${N##*:}"
    ZIEL=$(fw_dienste "$PID" "$SKRIPT")
    if [ -n "$ZIEL" ]; then
        kill $ZIEL 2>/dev/null || true
        for i in 1 2 3 4 5; do
            [ -n "$(fw_dienste "$PID" "$SKRIPT")" ] || break
            sleep 1
        done
        # Vor dem harten Signal NEU suchen: zwischen den beiden Signalen kann
        # ein Prozess enden und seine Nummer neu vergeben werden.
        REST=$(fw_dienste "$PID" "$SKRIPT")
        [ -n "$REST" ] && kill -9 $REST 2>/dev/null || true
    fi
    rm -f "$PID"
done

# Behaltene MQTT-Themen der Funkwacht am Broker loeschen (seit 1.0.7).
#
# Erst hier, NACH dem Anhalten von Waechter und Mithoerer: ein noch laufender
# Waechter schriebe die eben geloeschten Themen im naechsten Takt wieder hin.
# Bis 1.0.6 blieben sie nach dem Deinstallieren im Broker stehen - Einrichtung
# und Verlauf gehen seit 1.0.3 retained hinaus (Pruefung-Funkwacht-1.0.7,
# messe_nachlese.sh, Faelle U1-U4). Regeln/07 Abschnitt 3: die Deinstallation
# raeumt die retained Themen ab, wo die Linie einen Brokerweg hat.
#
# funkwacht_dienst.py --mqtt-leeren meldet sich mit den Zugangsdaten der
# eigenen Konfiguration bzw. der general.json am Broker an (paho aus
# dpkg/apt), loescht nur, was die Funkwacht sendet und WIRKLICH behalten
# liegt - auch Themen geloeschter Sticks -, und liest nach. Nur ohne Broker
# oder ohne paho geht es ueber den UDP-Eingang des Gateways, und die Ausgabe
# sagt, dass das nichts bestaetigt. bin/plugins/<ordner> und die
# Konfiguration sind hier noch da: der Installer loescht sie erst nach
# diesem Skript (purge_installation; am Geraet nachgesehen 17.09.2026, belegt
# in LoxBerry-Plugin-Skoda-Connect-NG-0.9.26/uninstall/uninstall). Als
# loxberry, nicht als root: gebraucht wird nur Lesezugriff.
FW_PY="$PBIN/funkwacht_dienst.py"
FW_PYBIN=$(command -v python3 2>/dev/null)
if [ ! -f "$FW_PY" ]; then
    echo "<INFO> $FW_PY fehlt - behaltene MQTT-Themen wurden nicht geloescht."
elif [ -z "$FW_PYBIN" ]; then
    echo "<INFO> Kein python3 gefunden - behaltene MQTT-Themen wurden nicht geloescht."
elif [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
    su -s /bin/bash loxberry -c "$(printf 'LBHOMEDIR=%q LBPPLUGINDIR=%q PYTHONDONTWRITEBYTECODE=1 timeout 60 %q %q --mqtt-leeren' \
        "$BASE" "$PFOLDER" "$FW_PYBIN" "$FW_PY")" 2>&1 || true
else
    LBHOMEDIR="$BASE" LBPPLUGINDIR="$PFOLDER" PYTHONDONTWRITEBYTECODE=1 \
        timeout 60 "$FW_PYBIN" "$FW_PY" --mqtt-leeren 2>&1 || true
fi

# Beides liegt NEBEN dem jeweiligen Ordner und ueberlebt deshalb jedes
# Update - also auch das Deinstallieren, wenn es hier nicht steht.
rm -f "$BASE/config/plugins/$PFOLDER.backup.json"
rm -rf "$BASE/data/plugins/$PFOLDER.bestand"
# S1 (Pruefung 29.09.2026): was postinstall.sh bei einer Neuinstallation
# beiseitegelegt hat (.alt), und Reste eines abgebrochenen Sicherns (.neu).
rm -f "$BASE/config/plugins/$PFOLDER.backup.json.alt" "$BASE/config/plugins/$PFOLDER.backup.json.neu"
rm -rf "$BASE/data/plugins/$PFOLDER.bestand.alt" "$BASE/data/plugins/$PFOLDER.bestand.neu"
# Die Upgrade-Marke liegt ebenfalls NEBEN dem Ordner. Bliebe sie liegen,
# haette eine spaetere Neuinstallation eine fremde Marke vor sich - sie gilt
# zwar nach 3600 s nicht mehr, aber liegenlassen ist kein Aufraeumen.
rm -f "$BASE/data/plugins/$PFOLDER.upgrade_laeuft"
rm -rf "$BASE/data/plugins/$PFOLDER"

echo "<OK> Funkwacht entfernt, Sicherungsdatei geloescht."
exit 0
