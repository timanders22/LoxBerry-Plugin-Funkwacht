#!/bin/bash
#
# Wachhund fuer den Wachhund: laeuft der Dienst nicht, wird er gestartet.
# Das ist keine Doppelung des Dienstes selbst - es faengt den Fall ab, dass
# der Dienst durch einen Neustart des Systems oder einen Absturz weg ist.

# Der Ordnername steht nicht fest: beansprucht ein zweites Plugin denselben
# FOLDER - LoxBerry haelt zwei Plugins mit verschiedenen Autoren fuer
# verschieden -, installiert der Kern das zweite nach "funkwacht01". Der
# Installer ersetzt den Platzhalter unten in jeder Textdatei des Archivs
# (plugininstall.pl, sub replaceenv). Bleibt er stehen - etwa beim Lauf aus
# einem entpackten Archiv -, greift der Rueckfall.
DIENST="REPLACELBPBINDIR/dienst.sh"
case "$DIENST" in
    REPLACE*)
        # Nicht vom Installer eingebaut (ausgepacktes Archiv, Pruefordner):
        # Wurzel und Ordnername werden GELESEN, nie aus dem Ablageort
        # gerechnet. Ohne beide geschieht nichts (Regeln/06). Bis 1.0.6 fiel
        # diese Stelle zwei Ebenen hinauf und auf einen festen Ordnernamen
        # zurueck (Pruefung-Funkwacht-1.0.6, Fall F5).
        if [ -z "${LBHOMEDIR:-}" ] || [ -z "${LBPPLUGINDIR:-}" ]; then
            echo "FEHLER: Platzhalter nicht ersetzt, LBHOMEDIR/LBPPLUGINDIR nicht gesetzt - nichts gestartet." >&2
            exit 1
        fi
        DIENST="$LBHOMEDIR/bin/plugins/$LBPPLUGINDIR/dienst.sh"
        ;;
esac
[ -x "$DIENST" ] || exit 0
exec "$DIENST" start >/dev/null 2>&1
